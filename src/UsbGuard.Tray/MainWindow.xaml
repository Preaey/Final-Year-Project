<Window x:Class="UsbGuard.Tray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="USB Guard" Width="820" Height="500" MinWidth="690" MinHeight="440"
        WindowStartupLocation="CenterScreen" Closing="OnClosing">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="USB Guard" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock x:Name="ServiceStatus" Text="Connecting to the Windows service."
                       TextWrapping="Wrap" Margin="0,5,0,16"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="Volumes" SelectionChanged="OnVolumeSelected">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,4">
                            <TextBlock Text="{Binding Volume}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Phase}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Column="1" Margin="14,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="VolumeStatus" Text="Connect a USB flash drive to begin."
                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                <ListView Grid.Row="1" x:Name="Findings">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Flagged file" Width="235" DisplayMemberBinding="{Binding Path}"/>
                            <GridViewColumn Header="Detection" Width="180" DisplayMemberBinding="{Binding Signature}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="RetryButton" Content="Scan again" Padding="12,6" Margin="0,0,8,0"
                    Click="OnRetry" IsEnabled="False"/>
            <Button x:Name="HoldButton" Content="Keep drive blocked" Padding="12,6" Margin="0,0,8,0"
                    Click="OnHold" IsEnabled="False"/>
            <Button x:Name="QuarantineButton" Content="Quarantine flagged files" Padding="12,6"
                    Click="OnQuarantine" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>
